<% content_for :page_title, "Tool - Transition Pathway Initiative" %>
<% content_for :page_description, "The TPI tool is a corporate climate action benchmark which assesses how prepared companies are for the transition to a low-carbon economy." %>

<div class="sectors-index-page">
  <div class="dropdown-selector-sector-page-wrapper">
    <%= react_component("DropdownSelector", {
        sectors: @sectors_json,
        companies: TPI::CompanyDecorator.decorate_collection(@companies),
        industries: @industries_json,
        selectedOption: 'All sectors'
    }) %>
  </div>

  <div class="sectors-header">
    <div class="container">
      <div class="mq-beta-scores">
        <div class="mq-beta-scores__download-button">
          <%= button_to user_download_methodology_tpi_sectors_path, class: 'button is-primary is-pulled-right with-icon with-border', method: :get do %>
            <img src="<%= asset_path 'icons/download.svg'%>" alt="download icon" />
            Methodology
          <% end %>
          <%= react_component('DownloadFormModal', {
            title: 'Explore CP data access',
            buttonClass: 'button is-primary with-icon with-border',
            downloadUrl: user_download_cp_all_tpi_sectors_path,
            source: 'cp',
            showIcon: true
          }) %>
          <span id="mq-download-form">
            <%= react_component('DownloadFormModal', {
              title: 'Explore MQ data access',
              buttonClass: 'button is-primary with-icon with-border',
              source: 'mq',
              showIcon: true,
              downloadScope: 'all'
            }) %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <section id="management-quality" class="container">
    <h3 class="title-blue">Explore the distribution of companies across all sectors based on greenhouse gas emissions management and low-carbon transition risks and opportunities.</h3>
    <h4 class="title-darker-blue">Below you will find the results of the Carbon Performance and Management Quality corporate assessments. These TPI metrics should be treated as complementary – i.e. both need to be looked at together to better assess the progress that companies are making in the low-carbon transition.</h4>

    <p class="title-darker-blue">
      The TPI Centre's data are governed by the <a href="https://www.transitionpathwayinitiative.org/use-of-the-centre-s-data" target="_blank" rel="noopener noreferrer">Terms of Use</a>. Management Quality (MQ) assessments for 10,000 companies, as shown below, are updated annually. A subset of 2,000 focus companies has been selected based on market capitalisation and emissions [see <a href="/faqs" target="_blank" rel="noopener noreferrer">FAQs</a>]. Information on how to access the data is available in the <a href="#" onclick="event.preventDefault(); document.querySelector('#mq-download-form button').click();">download form</a>.
    </p>
    <p class="title-darker-blue">
      Please note that more frequently updated MQ assessments are available from TPI's Data Partner, LSEG. To discuss further, please reach out to <a href="mailto:tpimqaccess@lseg.com">tpimqaccess@lseg.com</a>.
    </p>

    <div class="mq-sector-pie-charts-row">
      <%= react_component('charts/mq-sector-pie', {
        dataUrl: focus_levels_chart_data_tpi_sectors_path,
        title: 'Focus Companies by Management Quality'
      }) %>
      <%= react_component('charts/mq-sector-pie', {
        dataUrl: levels_chart_data_tpi_sectors_path,
        title: 'All Companies by Management Quality'
      }) %>
    </div>

    <h4>Number of Companies by Sector according to Management Quality</h4>
    <%= react_component('charts/bubble/Chart', {
      levels: @companies_by_sectors,
      sectors: @sectors_json,
      sectorIndustryMap: @sector_industry_map
    }) %>

    <%= react_component("charts/bubble/CompaniesAccordion", {
      levels: @companies_by_sectors,
      sectors: @sectors_json
    }) %>
  </section>

  <section id="carbon-performance" class="container">
    <h4>Carbon Performance: All sectors</h4>

    <p>CP alignment with the Paris agreement benchmarks by sector and cluster (number and % of companies). Please note that this information is not available for all sectors.</p>

    <%= react_component('charts/cp-performance-all-sectors', {
      dataUrl: cp_performance_chart_data_all_years_tpi_sectors_path,
      sectors: TPI::CPPerformanceSectorDecorator.decorate_collection(@sectors).map(&:to_h)
    }) %>
  </section>
</div>
