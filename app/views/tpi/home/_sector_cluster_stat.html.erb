<% if cluster.present? %>
  <div>
    <div class="stat-box">
      <div class="stat-box__icon"><%= image_tag icon %></div>
      <div class="stat-box__content">
        <div class="stat-box__number"><%= cluster.sectors_count_for_display %></div>
        <div class="stat-box__number"><%= cluster.display_name %></div>

      </div>
    </div>
    <div class="stat-box__sectors"><%= cluster.sector_names_for_display.join(', ') %></div>
  </div>
<% end %>
